root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{module,quirks,code_ref,tools}/**]
indent_style = tab
indent_size = tab
tab_width = 8

[assets/index.html]
indent_style = tab
indent_size = tab
tab_width = 8

[Makefile]
indent_style = tab
